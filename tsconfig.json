{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["esnext"],
    "allowJs": true,
    "jsx": "react-native",
    "noEmit": true,
    "isolatedModules": true,
    "strict": false,               /* Désactive temporairement le mode strict pour réduire les erreurs */
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "baseUrl": "./",
    "paths": {
      "*": ["src/*"]
    },
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,         /* CRUCIAL : Ignore les erreurs dans node_modules */
    "resolveJsonModule": true
  },
  "include": ["src"],             /* Force TS à ne regarder QUE votre code */
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js"]
}
